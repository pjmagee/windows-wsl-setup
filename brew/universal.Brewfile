# Shared CLI tools and language runtimes (Linux / WSL Homebrew).
# install.sh: brew bundle --file this --upgrade
# Do not add Compass (macOS-only cask) or Cloudflare cf (npm only).
# Do not add grok, claude, opencode, devtunnel, changie, hugo, stripe, or copilot.

brew "uv"
brew "rustup"
brew "bun"
brew "fnm"
brew "go"
brew "dotnet"
brew "gh"
brew "dagger"
brew "powershell"
brew "starship"
brew "zoxide"
brew "atuin"
brew "azure-cli"
brew "azure-dev"
brew "saml2aws"
brew "awscli"
brew "cloudflare-wrangler"
brew "cloudflared"
brew "helm"
brew "sevenzip"
brew "mongosh"
brew "fluxcd"

cask "1password-cli"
cask "gcloud-cli"
