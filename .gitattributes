# Shell that runs inside WSL. Windows checkouts with core.autocrlf=true
# must not turn these into CRLF — bootstrap pipes ensure-user.sh to bash.
*.sh text eol=lf
*.py text eol=lf
*.ico binary
scripts/wsl-open text eol=lf
packages/apt.txt text eol=lf
profiles/*.txt text eol=lf
profiles/tools.json text eol=lf
