#!/usr/bin/env bash
# Open http(s)/mailto in the Windows default browser.
# When installed as xdg-open, other targets fall through to /usr/bin/xdg-open.
set -euo pipefail

usage() { echo "usage: $(basename "$0") <url-or-file>" >&2; exit 1; }
[ $# -ge 1 ] || usage

target="$1"
me="$(basename "$0")"

is_web() {
  case "$1" in
    http://*|https://*|mailto:*|ftp://*|www.*) return 0 ;;
    *) return 1 ;;
  esac
}

win_start() {
  local url="$1"
  if [ -x /mnt/c/Windows/System32/rundll32.exe ]; then
    /mnt/c/Windows/System32/rundll32.exe url.dll,FileProtocolHandler "$url"
    return 0
  fi
  if command -v cmd.exe >/dev/null 2>&1; then
    cmd.exe /c start "" "$url" >/dev/null 2>&1
    return 0
  fi
  echo "wsl-open: Windows interop not available for: $url" >&2
  return 1
}

if [ "$me" = xdg-open ] && ! is_web "$target"; then
  exec /usr/bin/xdg-open "$@"
fi

if is_web "$target"; then
  [ "${target#www.}" = "$target" ] || target="https://$target"
  win_start "$target"
  exit $?
fi

if [ -e "$target" ]; then
  win_start "$(wslpath -w "$target")"
  exit $?
fi

win_start "$target"
