---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';

const base = import.meta.env.BASE_URL;
---
<Base>
  <section class="hero">
    <div class="layer layer-grid" data-speed="0.12"></div>
    <div class="layer" data-speed="0.22">
      <div class="orb orb-a"></div>
    </div>
    <div class="layer" data-speed="0.35">
      <div class="orb orb-b"></div>
    </div>
    <div class="wrap hero-grid">
      <div>
        <p class="kicker">messy pc → fresh windows 11</p>
        <h1>Export what you use.<br />Restore it clean.</h1>
        <p class="lede">
          Collect a snapshot of this machine: apps, data volumes, Linux disks.
          On a new Windows 11 install, restore that snapshot — or let
          <strong>Grok, Claude, or Codex</strong> drive the setup with our skill.
        </p>
        <div class="cta-row">
          <a class="btn" href="https://github.com/pjmagee/windows-wsl-setup/releases">Download the exe</a>
          <a class="btn ghost" href={`${base}docs/welcome/`}>Read the docs</a>
        </div>
      </div>
      <Terminal />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>The problem we solve</h2>
      <p class="sub">
        A used PC is a pile of installers, browser logins, and maybe a Linux
        environment. A reset throws that away. We export it first, then put
        the important parts back in a sensible order: password manager, your
        browser, then everything else.
      </p>
      <div class="cards">
        <article class="card">
          <div class="n">01 · collect</div>
          <h3>Snapshot</h3>
          <p>Apps, Linux disks, data volumes, browser bookmarks. Written to a drive that survives a Windows reinstall.</p>
        </article>
        <article class="card">
          <div class="n">02 · restore</div>
          <h3>Bring it back</h3>
          <p>Fresh Windows 11. Install the apps you ticked, remount your disks, open your browser with the extensions list.</p>
        </article>
        <article class="card">
          <div class="n">03 · new linux</div>
          <h3>Or start Linux new</h3>
          <p>Ubuntu, Debian, or Arch. A software profile bootstraps the CLIs that make sense on that distro.</p>
        </article>
        <article class="card">
          <div class="n">04 · agents</div>
          <h3>Agent-ready</h3>
          <p>Install our skill. The agent downloads the CLI, runs collect or restore, and talks JSON the whole way.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <h2>Hand it to an agent</h2>
        <p class="sub">
          Grok, Claude, Codex, Copilot — any of them. Install the skill from
          GitHub, then say “set up this PC.” They already know the commands.
        </p>
        <p class="note">
          Identity first (password manager), then your browser, then the rest.
          Linux CLIs come from Homebrew on the distro you picked.
        </p>
      </div>
      <pre><code>gh skill install pjmagee/windows-wsl-setup windows-wsl-setup --scope user --agent grok
npx skills add pjmagee/windows-wsl-setup -g -y

windows-wsl-setup collect
windows-wsl-setup restore
windows-wsl-setup new-wsl
windows-wsl-setup apply default</code></pre>
    </div>
  </section>
  <script>
    const layers = document.querySelectorAll('[data-speed]');
    const onScroll = () => {
      const y = window.scrollY;
      layers.forEach((el) => {
        const s = Number(el.dataset.speed || 0);
        el.style.transform = `translate3d(0, ${y * s}px, 0)`;
      });
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  </script>
</Base>
