---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import { EXE } from '../lib/links';

const base = import.meta.env.BASE_URL;
---
<Base>
  <section class="hero">
    <div class="layer layer-grid" data-speed="0.12"></div>
    <div class="layer" data-speed="0.22">
      <div class="orb orb-a"></div>
    </div>
    <div class="layer" data-speed="0.35">
      <div class="orb orb-b"></div>
    </div>
    <div class="wrap hero-grid">
      <div>
        <p class="kicker">windows 11 + wsl</p>
        <h1>Winget, WSL, and<br />named software lists</h1>
        <p class="lede">
          <code>wwm.exe</code> is a Windows app. Collect a kit for a fresh PC,
          back up or restore WSL disks, or create a new official distro
          instance — empty, or with a profile.
        </p>
        <div class="cta-row">
          <a class="btn" href={EXE}>Download for Windows</a>
          <a class="btn ghost" href={`${base}docs/getting-started/`}>Documentation</a>
        </div>
      </div>
      <Terminal />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>What wwm does</h2>
      <div class="cards">
        <article class="card">
          <div class="n">01 · windows</div>
          <h3>Install Windows software</h3>
          <p>Winget, in catalog order: password manager, then browser, then the rest. Collect a kit for a clean Windows 11 install.</p>
        </article>
        <article class="card">
          <div class="n">02 · wsl</div>
          <h3>New distro, empty or packed</h3>
          <p><code>blank</code> is a supported distro plus passwordless sudo. <code>home</code> / <code>work</code> also install Linux CLIs from the profile.</p>
        </article>
        <article class="card">
          <div class="n">03 · disks</div>
          <h3>Backup and restore WSL</h3>
          <p>Collect copies the VHDX into the kit. Restore remounts that disk. Other distros already on the machine stay installed.</p>
        </article>
        <article class="card">
          <div class="n">04 · profiles</div>
          <h3>Windows and Linux lists</h3>
          <p>Shipped <code>blank</code>, <code>default</code>, <code>home</code>, <code>work</code>. Tick packages, save your own, apply from the TUI or JSON CLI.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <h2>Built for agents</h2>
        <p class="sub">
          Install the skill. The CLI prints JSON. <code>wwm spec</code> is the
          OpenCLI map of every command.
        </p>
        <p class="note">
          Run it from Windows PowerShell, not from inside WSL.
        </p>
      </div>
      <pre><code>gh skill install pjmagee/wwm wwm-cli --scope user --agent grok

wwm spec
wwm collect
wwm restore
wwm new-wsl --profile blank --distro Debian
wwm apply home</code></pre>
    </div>
  </section>
  <script>
    const layers = document.querySelectorAll('[data-speed]');
    const onScroll = () => {
      const y = window.scrollY;
      layers.forEach((el) => {
        const s = Number(el.dataset.speed || 0);
        el.style.transform = `translate3d(0, ${y * s}px, 0)`;
      });
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  </script>
</Base>
