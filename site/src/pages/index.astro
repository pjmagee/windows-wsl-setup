---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';
import { EXE } from '../lib/links';

const base = import.meta.env.BASE_URL;
---
<Base>
  <section class="hero">
    <div class="layer layer-grid" data-speed="0.12"></div>
    <div class="layer" data-speed="0.22">
      <div class="orb orb-a"></div>
    </div>
    <div class="layer" data-speed="0.35">
      <div class="orb orb-b"></div>
    </div>
    <div class="wrap hero-grid">
      <div>
        <p class="kicker">windows 11 + wsl</p>
        <h1>Manage Windows 11 &amp;<br />WSL Distros</h1>
        <p class="lede">
          Collect a kit and restore it on a new installation of Windows.
          Restore existing WSL instances or provision new ones.
        </p>
        <div class="cta-row">
          <a class="btn" href={EXE}>Download for Windows</a>
          <a class="btn ghost" href={`${base}docs/getting-started/`}>Documentation</a>
        </div>
      </div>
      <Terminal />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Collect, Restore, New WSL, Profiles</h2>
      <div class="cards">
        <article class="card">
          <div class="n">01 · collect</div>
          <h3>Collect a kit</h3>
          <p>Snapshot this PC — apps, WSL disks, Dev Drive, Docker, Brave. Restore it on a new installation of Windows.</p>
        </article>
        <article class="card">
          <div class="n">02 · restore</div>
          <h3>Restore WSL</h3>
          <p>Restore existing WSL instances. Remount the collected disks and install the packages you tick.</p>
        </article>
        <article class="card">
          <div class="n">03 · new wsl</div>
          <h3>Provision Linux</h3>
          <p>Ubuntu, Debian, or Arch. Auto-configures passwordless sudo. Homebrew installations.</p>
        </article>
        <article class="card">
          <div class="n">04 · profiles</div>
          <h3>Apply a profile</h3>
          <p><code>default</code>, <code>home</code>, and <code>work</code> — or save your own.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <h2>Built for agents</h2>
        <p class="sub">
          Install the skill. Tell Grok, Claude, Codex, or Copilot to collect
          this PC, restore a kit, or apply a profile.
        </p>
        <p class="note">
          Winget installs the password manager first, then the browser, then
          the rest. Linux CLIs come from Homebrew.
        </p>
      </div>
      <pre><code>gh skill install pjmagee/windows-wsl-manager windows-wsl-setup --scope user --agent grok
npx skills add pjmagee/windows-wsl-manager --skill windows-wsl-setup -g -y

wwm collect
wwm restore
wwm new-wsl
wwm apply default</code></pre
    </div>
  </section>
  <script>
    const layers = document.querySelectorAll('[data-speed]');
    const onScroll = () => {
      const y = window.scrollY;
      layers.forEach((el) => {
        const s = Number(el.dataset.speed || 0);
        el.style.transform = `translate3d(0, ${y * s}px, 0)`;
      });
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  </script>
</Base>
