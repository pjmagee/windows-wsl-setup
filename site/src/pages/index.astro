---
import Base from '../layouts/Base.astro';
import Terminal from '../components/Terminal.astro';

const base = import.meta.env.BASE_URL;
---
<Base>
  <section class="hero">
    <div class="layer layer-grid" data-speed="0.12"></div>
    <div class="layer" data-speed="0.22">
      <div class="orb orb-a"></div>
    </div>
    <div class="layer" data-speed="0.35">
      <div class="orb orb-b"></div>
    </div>
    <div class="wrap hero-grid">
      <div>
        <p class="kicker">windows 11 + wsl</p>
        <h1>Manage this PC.<br />And the Linux next to it.</h1>
        <p class="lede">
          One Windows binary. Snapshot apps, data volumes, and Linux disks.
          Restore them after a clean install — or stand up Ubuntu, Debian, or
          Arch from a named software profile.
        </p>
        <div class="cta-row">
          <a class="btn" href="https://github.com/pjmagee/windows-wsl-manager/releases">Download the exe</a>
          <a class="btn ghost" href={`${base}docs/getting-started/`}>Get started</a>
        </div>
      </div>
      <Terminal />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Four modes, same exe</h2>
      <p class="sub">
        Run <code>windows-wsl-setup</code> with no arguments. The home screen
        is the product: Collect, Restore, New WSL, Profiles. A kit is what
        this machine has. A profile is what you want installed.
      </p>
      <div class="cards">
        <article class="card">
          <div class="n">01 · collect</div>
          <h3>Snapshot this PC</h3>
          <p>Winget apps, WSL disks, Dev Drive, Docker data, Brave bookmarks. Written off <code>C:</code> so a Windows reinstall cannot eat it.</p>
        </article>
        <article class="card">
          <div class="n">02 · restore</div>
          <h3>Bring the kit back</h3>
          <p>Fresh Windows 11. Install the packages you tick, remount the same disks, copy Brave bookmarks, open the extensions list.</p>
        </article>
        <article class="card">
          <div class="n">03 · new wsl</div>
          <h3>Or start Linux new</h3>
          <p>Ubuntu 26.04, Debian, or Arch. User, passwordless sudo, Homebrew CLIs. You never clone; the exe clones the installer inside Linux.</p>
        </article>
        <article class="card">
          <div class="n">04 · profiles</div>
          <h3>Named software lists</h3>
          <p>Shipped <code>default</code>, <code>home</code>, and <code>work</code>. Suggest from what is installed. Apply never uninstalls Windows apps.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <h2>Hand it to an agent</h2>
        <p class="sub">
          Grok, Claude, Codex, Copilot. Install the skill from this GitHub
          repo, then say “collect this PC” or “apply work.” They download the
          exe. They do not clone as a substitute.
        </p>
        <p class="note">
          Identity first (password manager), then Brave, then the rest.
          Linux CLIs come from Homebrew on the distro you picked.
        </p>
      </div>
      <pre><code>gh skill install pjmagee/windows-wsl-manager windows-wsl-setup --scope user --agent grok
npx skills add pjmagee/windows-wsl-manager --skill windows-wsl-setup -g -y

windows-wsl-setup collect
windows-wsl-setup restore
windows-wsl-setup new-wsl
windows-wsl-setup apply default</code></pre>
    </div>
  </section>
  <script>
    const layers = document.querySelectorAll('[data-speed]');
    const onScroll = () => {
      const y = window.scrollY;
      layers.forEach((el) => {
        const s = Number(el.dataset.speed || 0);
        el.style.transform = `translate3d(0, ${y * s}px, 0)`;
      });
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  </script>
</Base>
