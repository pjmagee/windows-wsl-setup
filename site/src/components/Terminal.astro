---
const sessions = [
  {
    id: 'distros',
    tab: 'Windows PowerShell',
    kind: 'ps',
    html: `Windows PowerShell
Copyright (C) Microsoft Corporation. All rights reserved.

<span class="c-ps">PS C:\\Users\\patrick&gt;</span> wwm distros

{
  <span class="c-key">"choices"</span>: [
    { <span class="c-key">"id"</span>: <span class="c-str">"Ubuntu-26.04"</span>, <span class="c-key">"installed"</span>: <span class="c-bool">true</span>, <span class="c-key">"online"</span>: <span class="c-bool">true</span> },
    { <span class="c-key">"id"</span>: <span class="c-str">"Debian"</span>, <span class="c-key">"installed"</span>: <span class="c-bool">true</span>, <span class="c-key">"online"</span>: <span class="c-bool">true</span> },
    { <span class="c-key">"id"</span>: <span class="c-str">"archlinux"</span>, <span class="c-key">"installed"</span>: <span class="c-bool">false</span>, <span class="c-key">"online"</span>: <span class="c-bool">true</span> },
    { <span class="c-key">"id"</span>: <span class="c-str">"kali-linux"</span>, <span class="c-key">"installed"</span>: <span class="c-bool">false</span>, <span class="c-key">"online"</span>: <span class="c-bool">true</span> },
    { <span class="c-key">"id"</span>: <span class="c-str">"FedoraLinux-44"</span>, <span class="c-key">"installed"</span>: <span class="c-bool">false</span>, <span class="c-key">"online"</span>: <span class="c-bool">true</span> }
  ],
  <span class="c-key">"default"</span>: <span class="c-str">"Ubuntu-26.04"</span>,
  <span class="c-key">"installed"</span>: [<span class="c-str">"Ubuntu-26.04"</span>, <span class="c-str">"Debian"</span>, <span class="c-str">"docker-desktop"</span>]
}

<span class="c-ps">PS C:\\Users\\patrick&gt;</span> <span class="caret"></span>`,
  },
  {
    id: 'blank',
    tab: 'Windows PowerShell',
    kind: 'ps',
    html: `Windows PowerShell
Copyright (C) Microsoft Corporation. All rights reserved.

<span class="c-ps">PS C:\\Users\\patrick&gt;</span> wwm new-wsl --profile blank --distro Debian

[
  { <span class="c-key">"step"</span>: <span class="c-str">"distro"</span>, <span class="c-key">"ok"</span>: <span class="c-bool">true</span>, <span class="c-key">"detail"</span>: <span class="c-str">"Debian installed."</span> },
  { <span class="c-key">"step"</span>: <span class="c-str">"user"</span>, <span class="c-key">"ok"</span>: <span class="c-bool">true</span>, <span class="c-key">"detail"</span>: <span class="c-str">"created patri (uid 1000, empty password)"</span> },
  { <span class="c-key">"step"</span>: <span class="c-str">"sudo"</span>, <span class="c-key">"ok"</span>: <span class="c-bool">true</span>, <span class="c-key">"detail"</span>: <span class="c-str">"ok user=patri"</span> },
  { <span class="c-key">"step"</span>: <span class="c-str">"default-distro"</span>, <span class="c-key">"ok"</span>: <span class="c-bool">true</span>, <span class="c-key">"detail"</span>: <span class="c-str">"left default as Ubuntu-26.04 (added Debian beside it)"</span> },
  { <span class="c-key">"step"</span>: <span class="c-str">"linux"</span>, <span class="c-key">"ok"</span>: <span class="c-bool">true</span>, <span class="c-key">"detail"</span>: <span class="c-str">"blank: distro + passwordless sudo only"</span> }
]

<span class="c-ps">PS C:\\Users\\patrick&gt;</span> <span class="caret"></span>`,
  },
  {
    id: 'map',
    tab: 'Windows PowerShell',
    kind: 'ps',
    html: `Windows PowerShell
Copyright (C) Microsoft Corporation. All rights reserved.

<span class="c-ps">PS C:\\Users\\patrick&gt;</span> wwm map Microsoft.AzureCLI

{
  <span class="c-key">"windows"</span>: <span class="c-str">"Microsoft.AzureCLI"</span>,
  <span class="c-key">"category"</span>: <span class="c-str">"cloud"</span>,
  <span class="c-key">"preferLinux"</span>: <span class="c-bool">true</span>,
  <span class="c-key">"linux"</span>: <span class="c-str">"azure-cli"</span>
}

<span class="c-ps">PS C:\\Users\\patrick&gt;</span> <span class="caret"></span>`,
  },
];
---

<div class="wt" data-term>
  <div class="wt-bar">
    <div class="wt-tabs" role="tablist">
      {sessions.map((s, i) => (
        <button type="button" class:list={['wt-tab', { on: i === 0 }]} data-i={i} role="tab">
          <svg class="wt-ico ps" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M2.2 3.2 7.3 8 2.2 12.8l1.3 1.4L10.2 8 3.5 1.8z" />
            <path d="M8.2 12.4h5.6v1.8H8.2z" />
          </svg>
          <span>{s.tab}</span>
        </button>
      ))}
      <span class="wt-new" aria-hidden="true">
        <span>+</span>
        <span class="wt-chev">▾</span>
      </span>
    </div>
    <div class="wt-win" aria-hidden="true">
      <span class="wt-w">─</span>
      <span class="wt-w">□</span>
      <span class="wt-w x">✕</span>
    </div>
  </div>
  <div class="wt-body" data-out set:html={sessions[0].html} />
</div>

<script define:vars={{ sessions }}>
  const root = document.querySelector('[data-term]');
  if (root) {
    const out = root.querySelector('[data-out]');
    const buttons = [...root.querySelectorAll('.wt-tab')];
    const show = (i) => {
      out.innerHTML = sessions[i].html;
      buttons.forEach((b, n) => b.classList.toggle('on', n === i));
    };
    buttons.forEach((b) => b.addEventListener('click', () => show(Number(b.dataset.i))));
  }
</script>
