---
const ico = {
  grid: `<svg class="wt-ico" viewBox="0 0 16 16" aria-hidden="true"><rect x="1" y="1" width="6.2" height="6.2" rx="1.2" fill="#e95420"/><rect x="8.8" y="1" width="6.2" height="6.2" rx="1.2" fill="#a80030"/><rect x="1" y="8.8" width="6.2" height="6.2" rx="1.2" fill="#1793d1"/><rect x="8.8" y="8.8" width="6.2" height="6.2" rx="1.2" fill="#294172"/></svg>`,
  ubu: `<svg class="wt-ico" viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="7" fill="#e95420"/><circle cx="8" cy="3.5" r="1.4" fill="#fff"/><circle cx="4.1" cy="10.5" r="1.4" fill="#fff"/><circle cx="11.9" cy="10.5" r="1.4" fill="#fff"/></svg>`,
  ps: `<svg class="wt-ico ps" viewBox="0 0 16 16" aria-hidden="true"><path d="M2.2 3.2 7.3 8 2.2 12.8l1.3 1.4L10.2 8 3.5 1.8z"/><path d="M8.2 12.4h5.6v1.8H8.2z"/></svg>`,
};

const distros = [
  { id: 'Ubuntu-26.04', def: true },
  { id: 'Debian', def: false },
  { id: 'archlinux', def: false },
  { id: 'kali-linux', def: false },
  { id: 'FedoraLinux-44', def: false },
  { id: 'AlmaLinux-10', def: false },
  { id: 'openSUSE-Tumbleweed', def: false },
  { id: 'OracleLinux_9_5', def: false },
];

const sessions: { id: string; label: string; ico: keyof typeof ico; html: string }[] = [
  {
    id: 'distros',
    label: 'Distros',
    ico: 'grid',
    html: `<div class="wt-cmd"><span class="c-ps">PS&gt;</span> wwm distros</div>
<ul class="wt-distros">${distros
      .map(
        (d) =>
          `<li${d.def ? ' class="def"' : ''}><span class="star">${d.def ? '*' : ''}</span>${d.id}</li>`,
      )
      .join('')}</ul>
<div class="wt-cmd"><span class="c-ps">PS&gt;</span> <span class="caret"></span></div>`,
  },
  {
    id: 'new-wsl',
    label: 'New WSL',
    ico: 'ubu',
    html: `<div class="wt-cmd"><span class="c-ps">PS&gt;</span> wwm new-wsl --profile blank --distro Debian</div>
<div class="wt-log"><span class="c-ok">ok</span> Debian installed</div>
<div class="wt-log"><span class="c-ok">ok</span> user alex</div>
<div class="wt-log"><span class="c-ok">ok</span> passwordless sudo</div>
<div class="wt-log"><span class="c-ok">ok</span> beside Ubuntu-26.04</div>
<div class="wt-cmd"><span class="c-ps">PS&gt;</span> <span class="caret"></span></div>`,
  },
  {
    id: 'map',
    label: 'Map',
    ico: 'ps',
    html: `<div class="wt-cmd"><span class="c-ps">PS&gt;</span> wwm map Microsoft.AzureCLI</div>
<div class="wt-log">Azure CLI  →  <span class="c-str">azure-cli</span>  on Linux</div>
<div class="wt-cmd"><span class="c-ps">PS&gt;</span> <span class="caret"></span></div>`,
  },
];
---

<div class="wt" data-term>
  <div class="wt-bar">
    <div class="wt-tabs" role="tablist">
      {sessions.map((s, i) => (
        <button
          type="button"
          class:list={['wt-tab', { on: i === 0 }]}
          data-i={i}
          role="tab"
          aria-selected={i === 0}
          aria-label={s.label}
          title={s.label}
        >
          <Fragment set:html={ico[s.ico]} />
        </button>
      ))}
      <span class="wt-new" aria-hidden="true">
        <span>+</span>
        <span class="wt-chev">▾</span>
      </span>
    </div>
    <div class="wt-win" aria-hidden="true">
      <span class="wt-w">─</span>
      <span class="wt-w">□</span>
      <span class="wt-w x">✕</span>
    </div>
  </div>
  <div class="wt-body" data-out set:html={sessions[0].html} />
</div>

<script define:vars={{ sessions }}>
  const root = document.querySelector('[data-term]');
  if (root) {
    const out = root.querySelector('[data-out]');
    const buttons = [...root.querySelectorAll('.wt-tab')];
    const show = (i) => {
      out.innerHTML = sessions[i].html;
      buttons.forEach((b, n) => {
        const on = n === i;
        b.classList.toggle('on', on);
        b.setAttribute('aria-selected', on ? 'true' : 'false');
      });
    };
    buttons.forEach((b) => b.addEventListener('click', () => show(Number(b.dataset.i))));
  }
</script>
