---
import { EXE, RELEASES, INSTALL_PS } from '../lib/links';

const lines = INSTALL_PS.split('\n');
---
<div class="install">
  <div class="cta-row">
    <a class="btn" href={EXE}>Download for Windows</a>
    <a class="btn ghost" href={RELEASES}>View releases</a>
  </div>
  <p class="cta-meta">wwm.exe · Windows 11 · x86_64 · ~\.wwm</p>

  <div class="wt wt-install" data-install>
    <div class="wt-bar">
      <div class="wt-tabs" aria-hidden="true">
        <span class="wt-tab on" title="PowerShell" aria-label="PowerShell">
          <svg class="wt-ico ps" viewBox="0 0 16 16" aria-hidden="true">
            <path d="M2.2 3.2 7.3 8 2.2 12.8l1.3 1.4L10.2 8 3.5 1.8z" />
            <path d="M8.2 12.4h5.6v1.8H8.2z" />
          </svg>
        </span>
      </div>
      <button type="button" class="copy" data-copy>Copy</button>
    </div>
    <pre class="wt-body wt-install-body">{lines.map((line, i) => (
        <>
          {i > 0 && '\n'}
          <span class="c-ps">PS C:\Users\alex&gt;</span> {line}
        </>
      ))}</pre>
    <textarea hidden data-copy-text>{INSTALL_PS}</textarea>
  </div>
</div>

<script>
  document.querySelectorAll('[data-install]').forEach((root) => {
    const btn = root.querySelector('[data-copy]');
    const text = root.querySelector('[data-copy-text]')?.value;
    if (!btn || !text) return;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(text);
        btn.textContent = 'Copied';
        setTimeout(() => { btn.textContent = 'Copy'; }, 1600);
      } catch {
        btn.textContent = 'Copy failed';
      }
    });
  });
</script>
