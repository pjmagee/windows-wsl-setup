#!/usr/bin/env bash
# Copy stdin to the Windows clipboard. Do not use wslu/wslclip.
set -euo pipefail

clip=""
if [ -x /mnt/c/Windows/System32/clip.exe ]; then
  clip=/mnt/c/Windows/System32/clip.exe
elif command -v clip.exe >/dev/null 2>&1; then
  clip="$(command -v clip.exe)"
fi
if [ -z "$clip" ]; then
  echo "pbcopy: clip.exe not available (Windows interop)" >&2
  exit 1
fi
tr -d '\0' | "$clip"
